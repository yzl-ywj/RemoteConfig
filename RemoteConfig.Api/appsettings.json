{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "RemoteConfig": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey={{APPINSIGHTS_KEY}}"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "{{AZURE_TENANT_ID}}",
    "ClientId": "{{AZURE_AD_APP_ID}}",
    "Audience": "api://{{AZURE_AD_APP_ID}}"
  },
  "Database": {
    "ConnectionString": "Server=tcp:{{SQL_SERVER}}.database.windows.net,1433;Initial Catalog={{SQL_DATABASE}};Encrypt=True;TrustServerCertificate=False;Authentication=Active Directory Managed Identity;",
    "CommandTimeoutSeconds": 30
  },
  "RemoteConfig": {
    "MaxConfigSizeBytes": 65536,
    "MaxVersionsPerDevice": 50,
    "DefaultCommandTimeoutSeconds": 30,
    "PerDeviceRateLimit": 10,
    "PerTenantRateLimit": 100,
    "RedisKeyPrefix": "rc:cmd:",
    "ServiceBusQueueName": "device-commands",
    "DispatchMode": "ServiceBus"
  },
  "Redis": {
    "ConnectionString": "{{REDIS_HOSTNAME}}:6380,password={{REDIS_PASSWORD}},ssl=True,abortConnect=False",
    "DefaultTtlSeconds": 300,
    "InstanceName": "iot-rc"
  },
  "ServiceBus": {
    "ConnectionString": "Endpoint=sb://{{SERVICEBUS_NAMESPACE}}.servicebus.windows.net/;Authentication=ManagedIdentity;",
    "CommandQueueName": "device-commands",
    "MaxDeliveryAttempts": 3,
    "LockDurationSeconds": 30
  },
  "IoTHub": {
    "HostName": "{{IOTHUB_NAME}}.azure-devices.net",
    "ConnectionString": "HostName={{IOTHUB_NAME}}.azure-devices.net;Authentication=ManagedIdentity;",
    "DefaultMessageTtlSeconds": 60,
    "DirectMethodTimeoutSeconds": 30
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": true,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 100
      }
    ]
  }
}
